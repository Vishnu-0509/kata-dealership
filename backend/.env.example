# ==============================================================================
# KATA Car Dealership Inventory System - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the server:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS bash:   cp .env.example .env

# SQLite Database connection string (path relative to backend/prisma directory)
DATABASE_URL="file:./dev.db"

# Secret key for signing and verifying JWT authentication tokens.
# MANDATORY: Startup will fail if JWT_SECRET is unset or blank.
# Generate a cryptographically secure random string before starting the server:
#   Windows PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
#   Node.js CLI:        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Linux/macOS bash:   openssl rand -hex 32
JWT_SECRET="replace-with-your-generated-32-plus-char-secret"

# Port on which the Express HTTP server will listen
PORT=3001

# Allowed origin for Cross-Origin Resource Sharing (CORS)
FRONTEND_URL="http://localhost:5173"

# Node runtime environment mode: development | test | production
NODE_ENV="development"
